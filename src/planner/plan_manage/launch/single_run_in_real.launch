<launch>
    <!-- number of moving objects -->
    <arg name="drone_id" value="0"/>
    <arg name="map_size_x" value="100.0"/>
    <arg name="map_size_y" value="100.0"/>
    <arg name="map_size_z" value="20.0"/>

    <!-- topic of your odometry such as VIO or LIO -->
    <arg name="odom_topic" default="/mavros/local_position/odom" />

    <!-- ====================================== -->
    <!-- 新增：实机场景半径离群点去除参数（适配RPLIDAR S3） -->
    <!-- ====================================== -->
    <arg name="radius_search" default="0.20" />  <!-- 实机推荐：RPLIDAR S3点云稍稀疏，放大至0.2m -->
    <arg name="min_neighbors" default="4" />     <!-- 实机推荐：降低阈值，避免有效点误删 -->
    <arg name="raw_cloud_topic" default="/points" />  <!-- 激光雷达合并后的原始点云 -->
    <arg name="filtered_cloud_topic" default="/points_filtered" />  <!-- 过滤后点云 -->
    
    <include file="$(find ego_planner)/launch/rplidar_laserscan_merger.launch">
    </include>

    <!-- ====================================== -->
    <!-- 新增：实机场景 Radius Outlier Removal 节点 -->
    <!-- 注：放在激光雷达合并节点后，确保原始点云有数据 -->
    <!-- ====================================== -->
    <node name="radius_outlier_removal"
          pkg="nodelet" type="nodelet"
          args="standalone pcl/RadiusOutlierRemoval"
          output="screen">
        <!-- 话题重映射：激光雷达合并后的点云 → 过滤后点云 -->
        <remap from="~input" to="$(arg raw_cloud_topic)" />
        <remap from="~output" to="$(arg filtered_cloud_topic)" />
        <!-- 实机适配参数：RPLIDAR S3点云稀疏，半径稍大、阈值稍低 -->
        <param name="radius_search" value="$(arg radius_search)"/>
        <param name="min_neighbors" value="$(arg min_neighbors)"/>
    </node>

  <!-- main algorithm params -->
    <include file="$(find ego_planner)/launch/advanced_param_exp_real.xml">
        <arg name="use_distinctive_trajs" value="true" />
        <arg name="map_size_x_" value="$(arg map_size_x)"/>
        <arg name="drone_id" value="$(arg drone_id)"/>
        <arg name="map_size_y_" value="$(arg map_size_y)"/>
        <arg name="map_size_z_" value="$(arg map_size_z)"/>
        <arg name="odometry_topic" value="$(arg odom_topic)"/>
        <arg name="obj_num_set" value="10" />
        <!-- camera pose: transform of camera frame in the world frame -->
        <!-- depth topic: depth image, 640x480 by default -->
        <!-- don't set cloud_topic if you already set these ones! -->
        <arg name="camera_pose_topic" value="/camera_pose_in_map"/>
        <arg name="depth_topic" value="/roscam/front_cam/depth/image_raw"/>

        <!-- 关键修改：实机场景订阅过滤后的点云 -->
        <arg name="cloud_topic" value="$(arg filtered_cloud_topic)"/>

        <!-- intrinsic params of the depth camera -->
        <arg name="cx" value="319.5"/>
        <arg name="cy" value="239.5"/>
        <arg name="fx" value="205.5"/>
        <arg name="fy" value="207.0"/>

        <!-- maximum velocity and acceleration the drone will reach（实机低速） -->
        <arg name="max_vel" value="1" />
        <arg name="max_acc" value="1.0" />

        <!--always set to 1.5 times grater than sensing horizen-->
        <arg name="planning_horizon" value="10" /> 

        <!-- 1: use 2D Nav Goal to select goal  -->
        <!-- 2: use global waypoints below  -->
        <arg name="flight_type" value="1" />
        
        <!-- global waypoints -->
        <!-- It generates a piecewise min-snap traj passing all waypoints -->
        <arg name="point_num" value="5" />

        <arg name="point0_x" value="-15.0" />
        <arg name="point0_y" value="0.0" />
        <arg name="point0_z" value="1.0" />

        <arg name="point1_x" value="0.0" />
        <arg name="point1_y" value="15.0" />
        <arg name="point1_z" value="1.0" />

        <arg name="point2_x" value="15.0" />
        <arg name="point2_y" value="0.0" />
        <arg name="point2_z" value="1.0" />

        <arg name="point3_x" value="0.0" />
        <arg name="point3_y" value="-15.0" />
        <arg name="point3_z" value="1.0" />

        <arg name="point4_x" value="-15.0" />
        <arg name="point4_y" value="0.0" />
        <arg name="point4_z" value="1.0" />
    </include>
    <!-- trajectory server -->
    <node pkg="ego_planner" name="drone_$(arg drone_id)_traj_server" type="traj_server" output="screen">
        <!-- <remap from="position_cmd" to="/setpoints_cmd"/> -->
        <!-- <remap from="planning/bspline" to="drone_$(arg drone_id)_planning/bspline"/> -->
        <param name="traj_server/time_forward" value="1.0" type="double"/>
        <remap from="position_cmd" to="planning/pos_cmd"/>
    </node>
    <!-- <node name="rviz" pkg="rviz" type="rviz" args="-d $(find gazebo_sim)/launch/ego_planner.rviz" required="true" /> -->
</launch>